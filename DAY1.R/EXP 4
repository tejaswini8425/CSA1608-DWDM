Given data
x <- c(11,13,13,15,15,16,19,20,20,20,21,21,
       22,23,24,30,40,45,45,45,71,72,73,75)

# Divide data into bins of 4 values each
bins <- split(x, ceiling(seq_along(x)/4))

# (a) Smoothing by Bin Mean
cat("Smoothing by Bin Mean:\n")
bin_mean <- lapply(bins, function(b) rep(mean(b), length(b)))
print(unlist(bin_mean))

# (b) Smoothing by Bin Median
cat("\nSmoothing by Bin Median:\n")
bin_median <- lapply(bins, function(b) rep(median(b), length(b)))
print(unlist(bin_median))

# (c) Smoothing by Bin Boundaries
cat("\nSmoothing by Bin Boundaries:\n")
bin_boundaries <- lapply(bins, function(b) {
  low <- min(b)
  high <- max(b)
  sapply(b, function(v) {
    if (abs(v - low) <= abs(v - high)) low else high
  })
})
print(unlist(bin_boundaries))
