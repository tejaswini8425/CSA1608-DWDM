# age, frequency
age <- c(10,20,30,40,50,60)
frequency <- c(120,250,330,410,520,610)

# Median
medA <- median(age)
medF <- median(frequency)

cat("Median of age is:", medA, "\n")
cat("Median of frequency is:", medF, "\n")

# Mean
meanA <- mean(age)
meanF <- mean(frequency)

cat("Mean of age is:", meanA, "\n")
cat("Mean of frequency is:", meanF, "\n")
