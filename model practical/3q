# Loan Approval Dataset
loan <- data.frame(
  Income = c("Low", "Medium", "High", "Medium",
             "Low", "High", "Medium", "Low",
             "High", "Medium"),
  Credit = c("Poor", "Fair", "Excellent", "Poor",
             "Fair", "Excellent", "Excellent", "Poor",
             "Fair", "Excellent"),
  Collateral = c("No", "Yes", "No", "Yes",
                 "Yes", "Yes", "No", "Yes",
                 "Yes", "Yes"),
  Approved = c("No", "Yes", "Yes", "No",
               "No", "Yes", "Yes", "No",
               "Yes", "Yes")
)

# Display dataset
print(loan)

# Create ARFF file
arff <- c(
  "@relation LoanApproval",
  "@attribute Income {Low,Medium,High}",
  "@attribute Credit {Poor,Fair,Excellent}",
  "@attribute Collateral {No,Yes}",
  "@attribute Approved {No,Yes}",
  "@data"
)

for(i in 1:nrow(loan)) {
  arff <- c(arff, paste(
    loan$Income[i],
    loan$Credit[i],
    loan$Collateral[i],
    loan$Approved[i],
    sep = ","
  ))
}

writeLines(arff, "LoanApproval.arff")

# Input tuple
test <- data.frame(
  Income = "Medium",
  Credit = "Fair",
  Collateral = "Yes"
)

# Naive Bayes calculation
classes <- c("Yes", "No")

prob <- sapply(classes, function(cl) {
  d <- loan[loan$Approved == cl, ]
  
  p <- nrow(d) / nrow(loan)
  
  p <- p * mean(d$Income == test$Income)
  p <- p * mean(d$Credit == test$Credit)
  p <- p * mean(d$Collateral == test$Collateral)
  
  return(p)
})

cat("Class Probabilities:\n")
print(prob)

prediction <- classes[which.max(prob)]

cat("Predicted Loan Approval:", prediction)
